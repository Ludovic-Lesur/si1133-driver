#ifndef __SI1133_DRIVER_FLAGS_H__
#define __SI1133_DRIVER_FLAGS_H__

/*** SI1133 driver compilation flags ***/

#cmakedefine SI1133_DRIVER_I2C_ERROR_BASE_LAST                  @SI1133_DRIVER_I2C_ERROR_BASE_LAST@
#cmakedefine SI1133_DRIVER_DELAY_ERROR_BASE_LAST                @SI1133_DRIVER_DELAY_ERROR_BASE_LAST@

#cmakedefine SI1133_DRIVER_CALIBRATION_MODE                     @SI1133_DRIVER_CALIBRATION_MODE@

#cmakedefine SI1133_DRIVER_CALIBRATION_LUX_GAIN_NUMERATOR       @SI1133_DRIVER_CALIBRATION_LUX_GAIN_NUMERATOR@
#cmakedefine SI1133_DRIVER_CALIBRATION_LUX_GAIN_DENOMINATOR     @SI1133_DRIVER_CALIBRATION_LUX_GAIN_DENOMINATOR@

#cmakedefine SI1133_DRIVER_CALIBRATION_UVI_GAIN_NUMERATOR       @SI1133_DRIVER_CALIBRATION_UVI_GAIN_NUMERATOR@
#cmakedefine SI1133_DRIVER_CALIBRATION_UVI_GAIN_DENOMINATOR     @SI1133_DRIVER_CALIBRATION_UVI_GAIN_DENOMINATOR@

#endif /* __SI1133_DRIVER_FLAGS_H__ */
